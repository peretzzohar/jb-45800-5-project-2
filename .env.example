VITE_REST_SERVER_URL=https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd
VITE_SERVER_URL_CURRENCY=https://api.coingecko.com/api/v3/coins
VITE_LIVE_SERVER_URL=https://min-api.cryptocompare.com/data/v2/histominute?tsym=USD&limit=120&aggregate=5&fsym=<symbols>
VITE_AI_RECOMMENDATION_URL=https://api.coingecko.com/api/v3/coins/<coin-id>?market_data=true
# Optional: set this for automatic AI calls without typing key in the UI.
# VITE_NVIDIA_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# Production only (set in hosting platform env vars, not in client .env files):
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
